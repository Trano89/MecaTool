{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MecaTool",
  "version": "0.2.0",
  "identifier": "app.mecatool.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MecaTool",
        "width": 1240,
        "height": 840,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Assistant de tolérancement mécanique",
    "longDescription": "MecaTool calcule, vérifie et explique les tolérances et ajustements mécaniques normalisés.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
